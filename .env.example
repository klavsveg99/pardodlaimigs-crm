APP_NAME="Pārdod Laimīgs CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.pardodlaimigs.lv
APP_HOST=crm.pardodlaimigs.lv

APP_LOCALE=lv
APP_FALLBACK_LOCALE=lv
APP_FAKER_LOCALE=lv_LV

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Primary (CRM) database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u976787655_crm
DB_USERNAME=u976787655_crmuser
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# WordPress read-only database (cross-DB SELECT to ERE source)
WP_DB_HOST=localhost
WP_DB_PORT=3306
WP_DB_DATABASE=u976787655_pardod
WP_DB_USERNAME=u976787655_wppardod
WP_DB_PASSWORD=
WP_TABLE_PREFIX=wp_

# Sync bridge
WP_SITE_URL=https://pardodlaimigs.lv
WP_REST_PREFIX=wp-json/pdc/v1
WP_HMAC_SECRET=
WP_HMAC_HEADER=X-PDC-Signature

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@pardodlaimigs.lv
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=info@pardodlaimigs.lv
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOCALE=lv_LV
